<Window x:Class="YtDlpGui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:YtDlpGui"
        mc:Ignorable="d"
        Title="yt-dlp 圖形介面" Height="760" Width="900"
        MinHeight="640" MinWidth="760">
    <Window.Resources>
        <Style TargetType="Label">
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="4,2"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,4,16,4"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Padding" Value="8"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- yt-dlp path -->
            <RowDefinition Height="Auto"/> <!-- ffmpeg path -->
            <RowDefinition Height="Auto"/> <!-- url -->
            <RowDefinition Height="Auto"/> <!-- output folder -->
            <RowDefinition Height="Auto"/> <!-- options group -->
            <RowDefinition Height="Auto"/> <!-- cookies drop zone -->
            <RowDefinition Height="Auto"/> <!-- extra args -->
            <RowDefinition Height="Auto"/> <!-- action buttons -->
            <RowDefinition Height="Auto"/> <!-- progress -->
            <RowDefinition Height="*"/>    <!-- log -->
        </Grid.RowDefinitions>

        <!-- yt-dlp.exe path -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Label Grid.Column="0" Content="yt-dlp.exe 路徑："/>
            <TextBox Grid.Column="1" x:Name="YtDlpPathTextBox"/>
            <Button Grid.Column="2" Content="瀏覽…" Click="BrowseYtDlp_Click"/>
        </Grid>

        <!-- ffmpeg.exe path -->
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Label Grid.Column="0" Content="ffmpeg.exe 路徑（合併影音用）："/>
            <TextBox Grid.Column="1" x:Name="FfmpegPathTextBox"
                     ToolTip="用於將分離的影片/音訊檔合併輸出成 MP4。若已在 PATH 中可留空。"/>
            <Button Grid.Column="2" Content="瀏覽…" Click="BrowseFfmpeg_Click"/>
        </Grid>

        <!-- URL -->
        <Grid Grid.Row="2" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Label Grid.Column="0" Content="目標影片網址："/>
            <TextBox Grid.Column="1" x:Name="UrlTextBox" FontSize="14"/>
            <Button Grid.Column="2" x:Name="FetchFormatsButton" Content="取得可用格式清單 (-F)" Click="FetchFormatsButton_Click"/>
        </Grid>

        <!-- Output folder -->
        <Grid Grid.Row="3" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Label Grid.Column="0" Content="下載儲存資料夾："/>
            <TextBox Grid.Column="1" x:Name="OutputFolderTextBox"/>
            <Button Grid.Column="2" Content="瀏覽…" Click="BrowseOutputFolder_Click"/>
        </Grid>

        <!-- Options -->
        <GroupBox Grid.Row="4" Header="參數選項">
            <StackPanel>
                <WrapPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,4">
                        <Label Content="影片畫質："/>
                        <ComboBox x:Name="VideoQualityComboBox" Width="180" SelectedIndex="0">
                            <ComboBoxItem Content="最佳畫質" Tag="bestvideo*"/>
                            <ComboBoxItem Content="限制 1080p 以下" Tag="bestvideo*[height&lt;=1080]"/>
                            <ComboBoxItem Content="限制 720p 以下" Tag="bestvideo*[height&lt;=720]"/>
                            <ComboBoxItem Content="自訂格式代碼" Tag="CUSTOM"/>
                            <ComboBoxItem Content="不下載影片" Tag="NONE"/>
                        </ComboBox>
                        <TextBox x:Name="CustomVideoFormatTextBox" Width="90" Margin="6,0,0,0" IsEnabled="False"
                                 ToolTip="例如：137"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,4">
                        <Label Content="音訊格式："/>
                        <ComboBox x:Name="AudioFormatComboBox" Width="180" SelectedIndex="0">
                            <ComboBoxItem Content="最佳音質（原始格式）" Tag="bestaudio"/>
                            <ComboBoxItem x:Name="AudioMp3Item" Content="轉存為 mp3" Tag="AUDIO_ONLY|mp3"/>
                            <ComboBoxItem x:Name="AudioM4aItem" Content="轉存為 m4a" Tag="AUDIO_ONLY|m4a"/>
                            <ComboBoxItem Content="自訂格式代碼" Tag="CUSTOM"/>
                            <ComboBoxItem Content="不下載音訊" Tag="NONE"/>
                        </ComboBox>
                        <TextBox x:Name="CustomAudioFormatTextBox" Width="90" Margin="6,0,0,0" IsEnabled="False"
                                 ToolTip="例如：140"/>
                    </StackPanel>
                </WrapPanel>
                <WrapPanel Margin="0,4,0,0">
                    <CheckBox x:Name="MergeMp4CheckBox" Content="合併影片及音訊成 MP4" IsChecked="True"
                              ToolTip="需同時選擇影片與音訊才能勾選：勾選時用 ffmpeg 合併成單一 MP4；不勾選則個別下載影片檔與音訊檔"/>
                    <CheckBox x:Name="ConvertAudioToMp3CheckBox" Content="將選取的音訊格式轉存為 MP3"
                              ToolTip="僅音訊模式（不下載影片）且音訊格式選「最佳音質」或「自訂格式代碼」時可用：下載後用 ffmpeg 轉存成 mp3"/>
                    <CheckBox x:Name="PlaylistCheckBox" Content="下載整個播放清單"/>
                    <CheckBox x:Name="SubtitlesCheckBox" Content="下載並嵌入字幕"/>
                    <CheckBox x:Name="ThumbnailCheckBox" Content="嵌入縮圖"/>
                    <CheckBox x:Name="MetadataCheckBox" Content="嵌入中繼資料" IsChecked="True"/>
                    <CheckBox x:Name="RestrictFilenameCheckBox" Content="安全檔名（去除特殊字元）"/>
                    <CheckBox x:Name="IncludeIdInFilenameCheckBox" Content="檔名加上影片ID（避免同名覆蓋）"/>
                    <CheckBox x:Name="KeepOriginalCheckBox" Content="保留原始檔案不轉檔"/>
                </WrapPanel>
                <Expander x:Name="FormatsExpander" Margin="0,8,0,0" IsExpanded="False"
                          Header="可用格式清單（取得後顯示；選一個套用到影片或音訊，Ctrl/Shift 複選可同時套用影片+音訊兩個代碼）">
                    <StackPanel Margin="0,6,0,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Button x:Name="ApplyFormatsButton" Content="套用選取的格式" Click="ApplyFormatsButton_Click"/>
                            <TextBlock x:Name="FetchFormatsStatus" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="Gray"/>
                        </StackPanel>
                        <ListBox x:Name="FormatsListBox" Height="150" FontFamily="Consolas" FontSize="12"
                                 SelectionMode="Extended"
                                 MouseDoubleClick="FormatsListBox_MouseDoubleClick"/>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </GroupBox>

        <!-- Cookies drop zone -->
        <GroupBox Grid.Row="5" Header="Cookies 檔案（可選）">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="CookieDropZone" Grid.Column="0"
                        BorderBrush="Gray" BorderThickness="1.5"
                        CornerRadius="4"
                        Background="#10808080"
                        AllowDrop="True"
                        Drop="CookieDropZone_Drop"
                        DragEnter="CookieDropZone_DragEnter"
                        DragLeave="CookieDropZone_DragLeave"
                        Height="44">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <Trigger Property="Tag" Value="hover">
                                    <Setter Property="Background" Value="#308080FF"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock x:Name="CookieDropLabel"
                               Text="將 cookies.txt 拖曳到這裡（或點擊瀏覽）"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Foreground="Gray"/>
                </Border>
                <Button Grid.Column="1" Content="瀏覽…" Click="BrowseCookies_Click"/>
                <Button Grid.Column="2" Content="清除" Click="ClearCookies_Click"/>
            </Grid>
        </GroupBox>

        <!-- Extra args -->
        <Grid Grid.Row="6" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Label Grid.Column="0" Content="額外參數："/>
            <TextBox Grid.Column="1" x:Name="ExtraArgsTextBox"
                     ToolTip="任何額外的 yt-dlp 命令列參數，例如：--proxy http://127.0.0.1:1080"/>
        </Grid>

        <!-- Action buttons -->
        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,8">
            <Button x:Name="StartButton" Content="開始下載" Click="StartButton_Click" Background="#DFF0D8" FontWeight="Bold"/>
            <Button x:Name="StopButton" Content="停止" Click="StopButton_Click" IsEnabled="False"/>
            <Button x:Name="OpenFolderButton" Content="開啟下載資料夾" Click="OpenFolderButton_Click"/>
            <Button x:Name="ClearLogButton" Content="清除紀錄" Click="ClearLogButton_Click"/>
        </StackPanel>

        <!-- Progress -->
        <Grid Grid.Row="8" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ProgressBar Grid.Column="0" x:Name="DownloadProgressBar" Height="20" Minimum="0" Maximum="100"/>
            <TextBlock Grid.Column="1" x:Name="ProgressText" Margin="8,0,0,0" VerticalAlignment="Center" Width="60" Text="0%"/>
        </Grid>

        <!-- Log -->
        <GroupBox Grid.Row="9" Header="執行紀錄">
            <TextBox x:Name="LogTextBox"
                     IsReadOnly="True"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     TextWrapping="NoWrap"
                     FontFamily="Consolas"
                     FontSize="12"
                     Background="#1E1E1E"
                     Foreground="#DCDCDC"/>
        </GroupBox>
    </Grid>
</Window>
